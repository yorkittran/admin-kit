{
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun dev*)",
      "Bash(bun db:*)",
      "Bash(bunx drizzle-kit *)",
      "Bash(bunx biome *)",
      "Bash(docker compose *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/block-generated.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/post-edit-biome.ts"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
